# Copy to .env.local for local development; set the same keys in Vercel's project settings
# (Settings → Environment Variables). Never prefix these with VITE_: that would ship them to the browser.

# Resend API key (https://resend.com/api-keys). Use a "Sending access" key limited to the sending domain.
# Required on Vercel. Locally, leave it empty to print emails to the terminal instead of sending them.
RESEND_API_KEY=

# Sender of both emails, and by default also where the team notification goes.
# The domain must be verified in Resend. Required when RESEND_API_KEY is set.
MAIL_FROM="BeneFT <info@example.com>"

# Optional: send the team notification somewhere other than the MAIL_FROM address
CONSULTATION_NOTIFY_TO=
