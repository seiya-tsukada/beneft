# Copy to .env.local for local development; set the same keys in Vercel's project settings.

# Resend API key (https://resend.com/api-keys). Sending is stubbed for now, so this is optional.
RESEND_API_KEY=

# Sender of both emails. The domain must be verified in Resend.
MAIL_FROM="BeneFT <noreply@example.com>"

# Where consultation requests are sent to the sales team
CONSULTATION_NOTIFY_TO=sales@example.com
